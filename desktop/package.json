{
  "name": "veil-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Veil desktop browser for direct Chromium browsing",
  "main": "main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.veil.browser",
    "productName": "Veil",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
